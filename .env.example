# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The "publishable" key (older projects call it the "anon" key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# The "secret" key (older projects: "service_role"). Server only — never expose it.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Public URL of the app (used in email links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email alerts via Resend (optional; alerts are skipped if unset)
RESEND_API_KEY=
EMAIL_FROM="Ayal <alerts@your-domain.com>"
