# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The "publishable" key (older projects call it the "anon" key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# The "secret" key (older projects: "service_role"). Server only — never expose it.
# Used only to look up who to alert (email address, push devices).
SUPABASE_SECRET_KEY=sb_secret_xxx

# Public URL of the app (used in email links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Phone notifications (web push). Generate a pair once with:
#   npx web-push generate-vapid-keys
# Push is simply off if these are empty.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Email alerts via Resend (optional; skipped if unset)
RESEND_API_KEY=
EMAIL_FROM="Ayal <alerts@your-domain.com>"
